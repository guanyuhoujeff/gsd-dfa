{
  "$schema": "./schema.json",
  "name": "mini",
  "description": "Planning-only profile of gsd-dfa — strips the execution surface (executor, code review, ship, debug, validate, audit-fix) and is intended for spec-driven design work that hands off to other implementers. See docs/GSD-MINI-DESIGN.md.",
  "version": 1,
  "include": {
    "commands": [
      "new-project",
      "new-milestone",
      "complete-milestone",
      "map-codebase",
      "scan",
      "discuss-phase",
      "research-phase",
      "list-phase-assumptions",
      "plan-phase",
      "explore",
      "analyze-dependencies",
      "review",
      "dfa-scan",
      "dfa-model",
      "dfa-verify",
      "dfa-scenarios",
      "dfa-btree",
      "dfa-tests",
      "dfa-audit",
      "ui-phase",
      "ai-integration-phase",
      "mini-domain",
      "mini-aggregate",
      "add-phase",
      "insert-phase",
      "remove-phase",
      "add-backlog",
      "review-backlog",
      "plant-seed",
      "plan-milestone-gaps",
      "progress",
      "resume-work",
      "pause-work",
      "session-report",
      "stats",
      "milestone-summary",
      "thread",
      "note",
      "add-todo",
      "check-todos",
      "next",
      "do",
      "help",
      "settings",
      "set-profile",
      "update",
      "join-discord",
      "workstreams",
      "list-workspaces",
      "new-workspace",
      "remove-workspace",
      "health",
      "intel",
      "cleanup",
      "reapply-patches",
      "import",
      "from-gsd2",
      "forensics",
      "profile-user",
      "docs-update",
      "verify-work",
      "audit-milestone",
      "audit-uat"
    ],
    "agents": [
      "gsd-planner",
      "gsd-phase-researcher",
      "gsd-roadmapper",
      "gsd-plan-checker",
      "gsd-verifier",
      "gsd-doc-writer",
      "gsd-doc-verifier",
      "gsd-codebase-mapper",
      "gsd-project-researcher",
      "gsd-research-synthesizer",
      "gsd-advisor-researcher",
      "gsd-assumptions-analyzer",
      "gsd-domain-researcher",
      "gsd-framework-selector",
      "gsd-ai-researcher",
      "gsd-eval-planner",
      "gsd-ui-researcher",
      "gsd-ui-checker",
      "gsd-intel-updater",
      "gsd-user-profiler"
    ]
  },
  "exclude_summary": {
    "commands_excluded": [
      "execute-phase", "quick", "fast", "autonomous",
      "ship", "pr-branch",
      "add-tests", "validate-phase", "secure-phase",
      "code-review", "code-review-fix",
      "eval-review", "ui-review",
      "debug", "undo", "audit-fix"
    ],
    "agents_excluded": [
      "gsd-executor",
      "gsd-code-reviewer", "gsd-code-fixer",
      "gsd-security-auditor", "gsd-nyquist-auditor",
      "gsd-debugger",
      "gsd-eval-auditor", "gsd-ui-auditor",
      "gsd-integration-checker"
    ]
  }
}
